// Secrets.example.xcconfig
// 1. Copy this file to `Secrets.xcconfig` in the same folder (repo root).
// 2. Fill in values from Supabase → Project Settings → API (URL + publishable or anon key).
// 3. Fill in your TMDB API key from themoviedb.org/settings/api.
// 4. Never commit `Secrets.xcconfig` (it is gitignored).

SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = sb_publishable_YOUR_KEY_HERE
TMDB_API_KEY = YOUR_TMDB_API_KEY_HERE
